{
    "name": "lulalib",
    "version": "0.1.0",
    "description": "A declarative music composition DSL for JavaScript/TypeScript. Compiles to a serializable Score, no audio engine.",
    "type": "module",
    "license": "MIT",
    "author": "3mpty",
    "keywords": [
        "music",
        "dsl",
        "composition",
        "pattern",
        "score"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/just3mpty/lulalib.git"
    },
    "bugs": {
        "url": "https://github.com/just3mpty/lulalib/issues"
    },
    "homepage": "https://github.com/just3mpty/lulalib#readme",
    "engines": {
        "node": ">=18"
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "tsup && tsc -p tsconfig.build.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "coverage": "vitest run --coverage",
        "typecheck": "tsc --noEmit",
        "lint": "biome check .",
        "format": "biome format --write .",
        "prepublishOnly": "pnpm build"
    },
    "packageManager": "pnpm@10.30.3",
    "devDependencies": {
        "@biomejs/biome": "^2.5.5",
        "@types/node": "^26.1.1",
        "@vitest/coverage-v8": "^4.1.10",
        "tsup": "^8.5.1",
        "tsx": "^4.23.12",
        "typescript": "^7.0.2",
        "vitest": "^4.1.10"
    }
}
